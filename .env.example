# EigenCapital Environment Configuration
# Copy to .env and fill in values
#
# IMPORTANT: Never commit .env to version control.

# ── Execution Context ──────────────────────────────────────────
# Options: development | paper | live
EIGENCAPITAL_ENV=development

# ── MT5 Broker Connection ──────────────────────────────────────
# The system connects to MT5 via RPyC bridge (port 8001).
# MT5 terminal must be running separately.
# Broker credentials are managed inside MT5, not via env vars.

# ── Alerts (Optional) ─────────────────────────────────────────
# Telegram bot for operational alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Webhook for alert dispatch
# ALERT_WEBHOOK_URL=

# ── Risk Limits (Optional Override) ────────────────────────────
# These override config.toml values if set.
# Prefer configs/production/config.toml as single source of truth.
# MAX_LEVERAGE=2.0
# MAX_DRAWDOWN=0.10

# ── Frontend Dashboard ───────────────────────────────────────────
# WebSocket host (defaults to window.location.hostname)
# VITE_WS_HOST=
# WebSocket port (defaults to 8080)
# VITE_WS_PORT=
# API base path (defaults to /api/v1)
# VITE_API_BASE=

# Dashboard API key — MUST match DASHBOARD_API_KEY on the backend.
# Used for both REST (Authorization: Bearer) and the /ws/live WebSocket
# (?token=... query parameter). Vite inlines VITE_* variables into the
# frontend bundle, so this value ships to every browser that loads the
# dashboard: in production, serve the dashboard only behind a trusted
# network/reverse proxy, or inject the key at build/deploy time rather
# than committing it here. The default below is the local-dev fallback
# mirrored in the backend (DASHBOARD_API_KEY, see dashboard api/app.py).
# VITE_API_KEY=dev-key-change-in-production

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
