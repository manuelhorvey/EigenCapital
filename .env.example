# EigenCapital Environment Configuration
# Copy to .env and fill in values
#
# IMPORTANT: Never commit .env to version control.

# ── Execution Context ──────────────────────────────────────────
# Options: development | paper | live
EIGENCAPITAL_ENV=development

# ── MT5 Broker Connection ──────────────────────────────────────
# The system connects to MT5 via RPyC bridge (port 8001).
# MT5 terminal must be running separately.
# Broker credentials are managed inside MT5, not via env vars.

# ── Alerts (Optional) ─────────────────────────────────────────
# Telegram bot for operational alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Webhook for alert dispatch
# ALERT_WEBHOOK_URL=

# ── Risk Limits (Optional Override) ────────────────────────────
# These override config.toml values if set.
# Prefer configs/production/config.toml as single source of truth.
# MAX_LEVERAGE=2.0
# MAX_DRAWDOWN=0.10

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
