# EigenCapital Environment Configuration
# Copy to .env and fill in values

# Execution context: PAPER | LIVE | BACKTEST
EIGENCAPITAL_ENV=development

# Broker API (Phase 2+)
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_PAPER=true

# Data providers (Phase 1B+)
# DATA_PROVIDER=
# DATA_API_KEY=

# Risk limits
# MAX_LEVERAGE=2.0
# MAX_DRAWDOWN=0.10

# Logging
LOG_LEVEL=INFO
